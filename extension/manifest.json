{
  "name": "slopless",
  "description": "Mark GitHub accounts and filter pull request and issue lists.",
  "version": "1.0",
  "manifest_version": 3,
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["https://github.com/*", "https://slopless.byron.fun/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": {
    "service_worker": "scripts/background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "settings.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "Slopless",
    "default_popup": "index.html",
    "default_icon": "slopless-icon.png"
  },
  "content_scripts": [
    {
      "js": ["scripts/content.js"],
      "matches": ["https://github.com/*"]
    }
  ]
}
